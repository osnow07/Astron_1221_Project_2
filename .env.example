# Copy to ".env" next to target_llm.py.

# --- OSU Astronomy 1221 (typical) ---
ASTRO1221_API_KEY=sk-your-key-here
# Optional explicit proxy + model (defaults match your course notebook if omitted):
# OPENAI_BASE_URL=https://litellmproxy.osu-ai.org
# OPENAI_MODEL=openai/GPT-4.1-mini

# --- Personal OpenAI only (no OSU key) ---
